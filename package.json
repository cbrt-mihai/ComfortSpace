{
  "name": "comfort-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev --prefix app",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build --prefix app",
    "start": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lru-cache": "^11.1.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.2",
    "@types/yauzl": "^2.10.3",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "~6.0.2"
  }
}
